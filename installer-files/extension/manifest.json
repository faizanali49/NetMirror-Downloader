{
  "manifest_version": 3,
  "name": "NetMirror Stream Capture",
  "version": "2.0",
  "description": "Captures HLS/MP4 streams from JW Player sites with audio track selection and FFmpeg mux.",
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content_main.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
